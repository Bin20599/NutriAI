# Server-side only. NEVER expose SUPABASE_SECRET_KEY or OPENAI_API_KEY in browser code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_publishable_or_anon_key
SUPABASE_SECRET_KEY=your_server_side_secret_key
# Older Supabase projects may use SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

APP_ENV=development
ALLOW_GUEST_MODE=true
ALLOWED_ORIGINS=
MAX_MESSAGE_CHARS=6000
